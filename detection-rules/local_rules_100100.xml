<!--
  Custom Wazuh rule deployed at /var/ossec/etc/rules/local_rules.xml
  Parent rule 61138 = "New Windows Service Created" (Event 7045), level 5.
  Fires at level 12 when the service binary is in a user-writable location.

  imagePath is stored with doubled backslashes for this event type
  (C:\\Users\\Public\\updater.exe), so the pattern accepts one or two.
-->
<group name="windows,custom,persistence,">
  <rule id="100100" level="12">
    <if_sid>61138</if_sid>
    <field name="win.eventdata.imagePath" type="pcre2">(?i)\\{1,2}(temp|appdata|downloads|users\\{1,2}public)\\{1,2}</field>
    <description>Windows service installed from a user-writable path: $(win.eventdata.imagePath)</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
  </rule>
</group>
